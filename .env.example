APP_NAME=jpstock-trend
APP_ENV=dev
SECRET_KEY=change-this
TIMEZONE=Asia/Tokyo

DATABASE_URL=postgresql+psycopg://app:app@db:5432/jpstock
# ローカル開発でSQLiteを使う場合
# DATABASE_URL=sqlite:///./app.db

SYMBOL_LIST=7203.T,6758.T,AAPL
ANALYSIS_LOOKBACK_DAYS=500
NOTIFY_THRESHOLD=70

DISCORD_WEBHOOK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_EMAILS=you@example.com
AUTH_SKIP_ENABLED=false
AUTH_SKIP_EMAIL=dev@example.com
AUTH_SKIP_NAME=Dev User

WEEKLY_CRON_DAY_OF_WEEK=sun
WEEKLY_CRON_HOUR=9
WEEKLY_CRON_MINUTE=0
INGEST_CRON_HOUR=6
INGEST_CRON_MINUTE=30
